# Artikin environment variables — template (ARCHITECTURE §16.1).
# Copy to `.env.local` for local development. Never commit real secrets; `.env.local` is git-ignored.
# Variables already set in the shell take precedence over values in .env files.

# --- Database ---------------------------------------------------------------------------------
# PostgreSQL connection string (production: Neon pooled URL). Leave empty locally to use the
# embedded PGlite database (no install needed). Required on Vercel.
DATABASE_URL=
# Embedded PGlite data directory (local development only; ignored when DATABASE_URL is set).
# Each agent uses its own directory, e.g. .data/pglite-s2 (AGENTS.md). Default: .data/pglite
PGLITE_DATA_DIR=

# --- Authentication (Better Auth) -----------------------------------------------------------------
# Signing/encryption secret, at least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of the app. Optional locally (inferred from the request);
# required in production, e.g. https://artikin.example.com
BETTER_AUTH_URL=
# Optional extra trusted origins, comma-separated (e.g. Vercel preview URLs). The BETTER_AUTH_URL
# origin is always trusted.
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional OAuth providers — each one is enabled only when both values are set.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Application ----------------------------------------------------------------------------------
# Maximum number of workspaces per user (server setting). Default: 5
MAX_WORKSPACES_PER_USER=5
# Maximum number of personal figure presets ("My presets") per user (server setting). Default: 50
MAX_PRESETS_PER_USER=50

# --- Multi-agent development ---------------------------------------------------------------------
# Build output directory; set per shell (e.g. .next-s2), not here. Default: .next
# NEXT_DIST_DIR=
