{
  "name": "artikin",
  "version": "0.1.0",
  "private": true,
  "description": "Artikin — browser-based posable 3D mannequins for artists.",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"--require=./scripts/dev-network-guard.cjs $NODE_OPTIONS\" next dev -H localhost",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"--require=./scripts/dev-network-guard.cjs $NODE_OPTIONS\" next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"--require=./scripts/dev-network-guard.cjs $NODE_OPTIONS\" next start -H localhost",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:generate": "npx --yes auth@1.7.26 generate --config src/lib/auth/auth.ts --output src/lib/db/auth-schema.ts --yes",
    "format": "prettier --write",
    "lockfile:normalize": "node scripts/normalize-lockfile.mjs",
    "lockfile:check": "node scripts/normalize-lockfile.mjs --check",
    "verify": "npm run lockfile:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "vercel-build": "npm run typecheck && npm run db:migrate && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@pixiv/three-vrm": "~3.5.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "three": "~0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@next/env": "16.4.6",
    "@playwright/test": "~1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "~0.187.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
